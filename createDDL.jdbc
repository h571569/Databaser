CREATE TABLE oblig3.ANSATT (ANSATTID  SERIAL NOT NULL, ANSDATO DATE, BRUKERNAVN VARCHAR(255), ETTERNAVN VARCHAR(255), FORNAVN VARCHAR(255), MANEDSLONN INTEGER, STILLING VARCHAR(255), avdelingId INTEGER, PRIMARY KEY (ANSATTID))
CREATE TABLE oblig3.AVDELING (AVDELINGID  SERIAL NOT NULL, AVDELINGNAVN VARCHAR(255), sjefId INTEGER, PRIMARY KEY (AVDELINGID))
CREATE TABLE oblig3.PROSJEKT (PROSJEKTID  SERIAL NOT NULL, BESKRIVELSE VARCHAR(255), PROSJEKTNAVN VARCHAR(255), PRIMARY KEY (PROSJEKTID))
CREATE TABLE oblig3.PROSJEKTDELTAGELSE (TIMER INTEGER, ansattid INTEGER NOT NULL, prosjektid INTEGER NOT NULL, PRIMARY KEY (ansattid, prosjektid))
ALTER TABLE oblig3.ANSATT ADD CONSTRAINT FK_ANSATT_avdelingId FOREIGN KEY (avdelingId) REFERENCES oblig3.AVDELING (AVDELINGID)
ALTER TABLE oblig3.AVDELING ADD CONSTRAINT FK_AVDELING_sjefId FOREIGN KEY (sjefId) REFERENCES oblig3.ANSATT (ANSATTID)
ALTER TABLE oblig3.PROSJEKTDELTAGELSE ADD CONSTRAINT FK_PROSJEKTDELTAGELSE_ansattid FOREIGN KEY (ansattid) REFERENCES oblig3.ANSATT (ANSATTID)
ALTER TABLE oblig3.PROSJEKTDELTAGELSE ADD CONSTRAINT FK_PROSJEKTDELTAGELSE_prosjektid FOREIGN KEY (prosjektid) REFERENCES oblig3.PROSJEKT (PROSJEKTID)
