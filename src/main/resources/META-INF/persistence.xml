<?xml version="1.0" encoding="UTF-8" ?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="personPCU" transaction-type="RESOURCE_LOCAL">

        <class>Entity.Ansatt</class>
        <class>Entity.Avdeling</class>
        <!--  <class>Entity.Prosjekt</class>
        <class>Entity.ProsjektDeltagelse</class> -->

        <exclude-unlisted-classes>false</exclude-unlisted-classes>
        <properties>
            <!--  Generelle JPA properties -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <!--  Erstatt verdiene her med egen database (xxxx), bruker (xxxx) og passord (yyyy) -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:postgresql://ider-database.westeurope.cloudapp.azure.com:5433/h571569"/>
            <property name="jakarta.persistence.jdbc.user" value="h571569"/>
            <property name="jakarta.persistence.jdbc.password" value="123456"/>
            <property name="jakarta.persistence.exclude-unlisted-classes" value="false"/>
            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>
            <property name="eclipselink.ddl-generation.output-mode" value="both"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
            <property name="hibernate.use_sql_comments" value="false"/>

            <!-- Suppress detailed logs -->
            <property name="hibernate.generate_statistics" value="false"/>
            <!--  EclipseLink properties -->
            <!--  Se https://wiki.eclipse.org/EclipseLink/Examples/JPA/Logging -->
            <property name="eclipselink.logging.level" value="WARNING"/>
        </properties>

    </persistence-unit>
</persistence>